rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(email()));
    }

    function isActiveAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(email())) && adminDoc().data.active == true;
    }

    function hasRole(role) {
      return isActiveAdmin() && adminDoc().data.role == role;
    }

    function hasAnyRole(roles) {
      return isActiveAdmin() && adminDoc().data.role in roles;
    }

    function assignedShakha() {
      return adminDoc().data.assignedShakhaId;
    }

    function assignedVibhag() {
      return adminDoc().data.assignedVibhag;
    }

    function canManageShakha(shakhaId) {
      return hasRole("nationalAdmin")
        || (hasRole("shakhaAdmin") && assignedShakha() == shakhaId)
        || (hasRole("teacher") && assignedShakha() == shakhaId);
    }

    match /admins/{adminEmail} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if hasRole("nationalAdmin");
    }

    match /shakhas/{shakhaId} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if hasRole("nationalAdmin")
        || (hasRole("vibhagAdmin") && request.resource.data.vibhag == assignedVibhag())
        || (hasRole("shakhaAdmin") && assignedShakha() == shakhaId);
    }

    match /people/{personId} {
      allow read: if isActiveAdmin();
      allow create, update: if hasRole("nationalAdmin")
        || (
          hasRole("vibhagAdmin")
          && get(/databases/$(database)/documents/shakhas/$(request.resource.data.assignedShakhaId)).data.vibhag == assignedVibhag()
        )
        || canManageShakha(request.resource.data.assignedShakhaId);
      allow delete: if hasAnyRole(["nationalAdmin", "vibhagAdmin"]);
    }

    match /peopleShakha/{mappingId} {
      allow read: if isActiveAdmin();
      allow create, update: if hasRole("nationalAdmin") || canManageShakha(request.resource.data.shakhaId);
      allow delete: if hasAnyRole(["nationalAdmin", "vibhagAdmin"]);
    }

    match /attendance/{attendanceId} {
      allow read: if isActiveAdmin();
      allow create, update: if hasRole("nationalAdmin") || canManageShakha(request.resource.data.shakhaId);
      allow delete: if hasAnyRole(["nationalAdmin", "shakhaAdmin"]);
    }

    match /qrCodes/{qrId} {
      allow read: if isActiveAdmin();
      allow create, update: if hasRole("nationalAdmin") || canManageShakha(request.resource.data.shakhaId);
      allow delete: if hasAnyRole(["nationalAdmin", "shakhaAdmin"]);
    }

    match /announcements/{announcementId} {
      allow read: if isActiveAdmin();
      allow create, update: if hasAnyRole(["nationalAdmin", "vibhagAdmin", "shakhaAdmin"]);
      allow delete: if hasAnyRole(["nationalAdmin", "vibhagAdmin"]);
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(email()));
    }

    function isActiveAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(email()))
        && adminDoc().data.active == true;
    }

    function hasRole(role) {
      return isActiveAdmin() && adminDoc().data.role == role;
    }

    function hasAnyRole(roles) {
      return isActiveAdmin() && adminDoc().data.role in roles;
    }

    function assignedShakha() {
      return adminDoc().data.assignedShakhaId;
    }

    function assignedVibhag() {
      return adminDoc().data.assignedVibhag;
    }

    function shakhaVibhag(shakhaId) {
      return get(/databases/$(database)/documents/shakhas/$(shakhaId)).data.vibhag;
    }

    function canManageShakha(shakhaId) {
      return hasRole("nationalAdmin")
        || (hasRole("vibhagAdmin") && assignedVibhag() == shakhaVibhag(shakhaId))
        || (hasRole("shakhaAdmin") && assignedShakha() == shakhaId)
        || (hasRole("teacher") && assignedShakha() == shakhaId)
        || (hasRole("volunteer") && assignedShakha() == shakhaId);
    }

    match /admins/{adminEmail} {
      // Allow each signed-in user to read their own admin profile (bootstrap check).
      allow get: if signedIn() && adminEmail == email();
      allow list: if isActiveAdmin();
      allow create, update, delete: if hasRole("nationalAdmin");
    }

    match /shakhas/{shakhaId} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if hasRole("nationalAdmin")
        || (hasRole("vibhagAdmin") && request.resource.data.vibhag == assignedVibhag())
        || (hasRole("shakhaAdmin") && assignedShakha() == shakhaId);
    }

    // One doc per shakha+date: {shakhaId}_{YYYY-MM-DD}
    // Primary Sampark feed collection.
    match /sankhya/{entryId} {
      allow read: if isActiveAdmin();
      allow create, update: if hasRole("nationalAdmin")
        || canManageShakha(request.resource.data.shakhaId);
      allow delete: if hasAnyRole(["nationalAdmin", "vibhagAdmin", "shakhaAdmin"]);
    }
  }
}
